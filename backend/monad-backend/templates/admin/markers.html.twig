{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Scan markers{% endblock %}

{% block main %}
    <p class="text-muted">
        Every marker the current quests ask for, rendered on demand. There is no marker list to maintain:
        a marker exists because some <code>scan_qr</code> step names it in <code>expected_value</code>, and
        that string is what the app matches a scan against. Edit a quest and this sheet follows.
    </p>

    <p class="no-print">
        <button class="btn btn-primary" onclick="window.print()">Print sheet</button>
        <span class="text-muted ms-2">Cut and tape at chest height.</span>
    </p>

    {% if markers is empty %}
        <p class="text-muted">No quest asks for a scan yet.</p>
    {% else %}
        <div class="marker-grid">
            {% for marker in markers %}
                <figure class="marker">
                    <img src="{{ path('api_lab_marker_svg', {value: marker.value}) }}" alt="{{ marker.value }}">
                    <figcaption>
                        <div class="marker-label">{{ marker.label }}</div>
                        <code>{{ marker.value }}</code>
                        <div class="marker-quests text-muted">{{ marker.quests|map(q => q.name)|join(' · ') }}</div>
                    </figcaption>
                </figure>
            {% endfor %}
        </div>
    {% endif %}

    <style>
        .marker-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 18px; }
        .marker { border: 1px solid #bbb; padding: 14px; text-align: center; break-inside: avoid; margin: 0; }
        .marker img { width: 100%; max-width: 190px; height: auto; }
        .marker-label { font-weight: 700; margin-top: 8px; }
        .marker-quests { font-size: 11px; margin-top: 4px; }
        @media print {
            .no-print, .text-muted:first-of-type { display: none; }
            #main-menu, header, .content-top { display: none !important; }
        }
    </style>
{% endblock %}
